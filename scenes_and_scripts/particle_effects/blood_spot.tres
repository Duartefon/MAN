code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;



void vertex() {
// Input:3
	int n_out3p0 = INSTANCE_ID;


// Input:5
	vec4 n_out5p0 = INSTANCE_CUSTOM;


// VectorDecompose:6
	float n_out6p0 = n_out5p0.x;
	float n_out6p1 = n_out5p0.y;
	float n_out6p2 = n_out5p0.z;
	float n_out6p3 = n_out5p0.w;


// VectorCompose:4
	float n_in4p2 = 0.00000;
	vec3 n_out4p0 = vec3(float(n_out3p0), n_out6p1, n_in4p2);


// Output:0
	COLOR.rgb = n_out4p0;


}

void fragment() {
// ColorConstant:8
	vec4 n_out8p0 = vec4(0.900531, 0.053468, 0.053468, 1.000000);


// Input:15
	vec2 n_out15p0 = UV;


	vec2 n_out16p0;
// UVPolarCoord:16
	vec2 n_in16p1 = vec2(0.50000, 0.50000);
	float n_in16p2 = 1.00000;
	float n_in16p3 = 0.00000;
	{
		vec2 __dir = n_out15p0 - n_in16p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out16p0 = vec2(__radius * n_in16p2, __angle * n_in16p3);
	}


	vec3 n_out4p0;
// ColorFunc:4
	{
		vec3 c = vec3(n_out16p0, 0.0);
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out4p0 = vec3(max2, max2, max2);
	}


// FloatFunc:5
	float n_out5p0 = 1.0 - n_out4p0.x;


// Input:13
	vec4 n_out13p0 = COLOR;


// VectorDecompose:14
	float n_out14p0 = vec3(n_out13p0.xyz).x;
	float n_out14p1 = vec3(n_out13p0.xyz).y;
	float n_out14p2 = vec3(n_out13p0.xyz).z;


// FloatOp:11
	float n_in11p1 = 0.10000;
	float n_out11p0 = n_out14p0 * n_in11p1;


// UVFunc:12
	vec2 n_in12p1 = vec2(1.00000, 1.00000);
	vec2 n_out12p0 = vec2(n_out11p0) * n_in12p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out12p0);


// FloatOp:3
	float n_in3p1 = 5.00000;
	float n_out3p0 = pow(n_out2p0.x, n_in3p1);


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out5p0) * vec3(n_out3p0);


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out8p0.xyz) * n_out6p0;


// FloatFunc:17
	float n_out17p0 = 1.0 - n_out11p0;


// FloatOp:18
	float n_in18p0 = 0.80000;
	float n_out18p0 = n_in18p0 * n_out17p0;


// FloatFunc:9
	float n_out9p0 = 1.0 - n_out6p0.x;


// Output:0
	ALBEDO = n_out7p0;
	ALPHA = n_out18p0;
	ALPHA_SCISSOR_THRESHOLD = n_out9p0;


}
